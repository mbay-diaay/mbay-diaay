{
  "name": "mbay-diaay-angular",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/patch-vercel-assets-404.mjs",
