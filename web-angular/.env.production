# Source de vérité commitée pour le build de production (Vite).
# Ne pas compter sur vercel.json "env" : cette clé n'alimente que le runtime des
# fonctions serverless, pas la phase install/build.
#
# Branchement NestJS sur le VPS (api.mbaydiaay.com).
# Prototype fictif uniquement : VITE_DEMO_MODE=true et commenter VITE_API_URL.
VITE_DEMO_MODE=false
VITE_API_URL=https://api.mbaydiaay.com/v1
# M2–M5 portés dans le code mais fermés en prod (activation progressive).
VITE_ENABLE_EXTRA_MODULES=false
