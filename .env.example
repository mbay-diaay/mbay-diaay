# Copier en .env.local (jamais versionné) puis ajuster.
# Production Vercel : la source de vérité commitée est `.env.production` (pas vercel.json "env").

# Mode démonstration : comptes fictifs et courriel simulé affichés à l'écran.
# Fermé par défaut dans un build publié : il faut écrire "true" pour l'ouvrir (déploiement de production : variable
# obligatoire dans `.env.production`, "true" ou "false", `pnpm build` échoue sinon). En développement local, absent = ouvert.
# Mettre "false" avant tout branchement sur des données réelles.
VITE_DEMO_MODE=true

# Rapport d'erreurs du navigateur (facultatif) : adresse qui reçoit chaque erreur en JSON (sendBeacon).
# Les données personnelles sont retirées avant l'envoi. Vide = aucun envoi.
VITE_ERROR_REPORT_URL=
